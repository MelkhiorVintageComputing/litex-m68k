From 14683ccad1316ce77175f71a633c00f4c9c4139e Mon Sep 17 00:00:00 2001
From: Romain Dolbeau <romain@dolbeau.org>
Date: Wed, 21 Oct 2026 05:04:53 +0200
Subject: [PATCH] FSAVE while a released instruction waits for its release to
 be read

A register-to-register instruction (src_rr) and FMOVECR post their release,
null CA=0, and waited for the main processor to read it with SEQ=WAIT on
RESP_READ alone. A save request then went unanswered:

1. The previous instruction is still computing; the next command is latched,
   and the MPU polls the response CIR, null CA=1 IA=1.
2. The MPU takes an interrupt there (a mid-instruction frame, format $9), and
   its handler saves the FPU, as an operating system's context switch does.
3. The computation ends; the microcode takes the latched command, posts its
   release and waits for the read that the MPU, in the handler, will only do
   after RTE. The save CIR answers come-again for ever.

Found by Linux on RD68031 + RD68884, two processes using the FPU and the
timer preempting them: the machine froze in the scheduler's FSAVE.

Both now call wait_first, as the memory-source and FMOVE-out paths do: a save
request there saves an idle frame with the instruction pending, and FRESTORE
starts it again. The register file's output is taken after the call, one
clock later than before.

The ISS test test_interrupt_while_latched_behind_computation drives the
sequence for FMUL and FMOVECR and compares the registers with a run without
the interrupt; both hung before.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 tools/iss/tests/test_vs_model.py | 46 ++++++++++++++++++++++++++++++++
 tools/ucode/arith_ucode.py       | 12 ++++++---
 2 files changed, 54 insertions(+), 4 deletions(-)

diff --git a/tools/iss/tests/test_vs_model.py b/tools/iss/tests/test_vs_model.py
index 01e9d5d..ec9b1d1 100644
--- a/tools/iss/tests/test_vs_model.py
+++ b/tools/iss/tests/test_vs_model.py
@@ -254,6 +254,52 @@ class IssOnly(unittest.TestCase):
         self.assertEqual(fpu.fp_bits80(1), F.encode_x(fin(0, 42, 0)).bits80())
         self.assertEqual(fpu.fp_bits80(6), F.encode_x(fin(0, 77, 0)).bits80())
 
+    def test_interrupt_while_latched_behind_computation(self):
+        """A register-to-register instruction latched while the one before it
+        computes: the MPU polls null CA=1 IA=1 and takes an interrupt. The
+        computation ends, the latched instruction starts and posts its release,
+        and the handler's FSAVE comes before the MPU has read it. FSAVE must
+        get a frame, not come-again forever (an idle frame, the instruction
+        pending, as when it waits for its first primitive). Both paths that
+        release before they start: register to register, and FMOVECR."""
+        def run(interrupt, latched):
+            fpu = Machine()
+            m = MPU(fpu)
+            done = []
+
+            def handler(mpu):
+                if done or not interrupt:
+                    return
+                done.append(1)
+                fpu.tick(20000)         # the FSIN ends, the latched one starts
+                h = MPU(fpu, m.mem)
+                h.a[7] = 0x8000
+                polls = []
+
+                def bounded(_):
+                    polls.append(1)
+                    self.assertLess(len(polls), 1000, 'FSAVE: come-again forever')
+                h.poll_hook = bounded
+                self.assertEqual(h.fsave(('predec', 7)), C.FW_IDLE)
+                flags = h.mem.read(h.a[7] + 0x18, 4)
+                self.assertEqual(flags >> 28 & 7, C.PEND_GEN)
+                h.fgen(cmd(2, FMT_X, 6, 0), ('imm', x96(fin(0, 77, 0)), 12))
+                h.fcond(0)      # FNOP: FRESTORE aborts a running instruction (FPU 7.2.4)
+                h.frestore(('postinc', 7))
+            m.fgen(cmd(2, FMT_X, 1, 0), ('imm', x96(fin(0, 3, 0)), 12))
+            m.fgen(cmd(2, FMT_X, 3, 0), ('imm', x96(fin(0, 5, 0)), 12))
+            m.fgen(cmd(0, 1, 2, 0x0E))  # FSIN FP1, FP2: released, computes
+            m.poll_hook = handler       # the latched one's polls, not the loads'
+            m.fgen(latched)             # latched behind it
+            m.fcond(0)                  # FNOP: waits for it
+            if interrupt:
+                self.assertTrue(done, 'the handler never ran')
+            return [fpu.fp_bits80(i) for i in (1, 2, 3)]
+        for latched in (cmd(0, 2, 3, 0x23),        # FMUL FP2, FP3
+                        cmd(2, 7, 3, 0x00)):       # FMOVECR #pi, FP3
+            with self.subTest(latched=hex(latched)):
+                self.assertEqual(run(True, latched), run(False, latched))
+
     def test_save_during_computation_waits(self):
         fpu = Machine()
         m = MPU(fpu)
diff --git a/tools/ucode/arith_ucode.py b/tools/ucode/arith_ucode.py
index c873323..ce81dcb 100644
--- a/tools/ucode/arith_ucode.py
+++ b/tools/ucode/arith_ucode.py
@@ -67,9 +67,12 @@ def emit(p):
     L('src_rr')
     u(RESP='WR', IMM=0x0900, ORS='PC', EXPECT='CMD', RF='READ', RFA='RX', FLAG=run,
       comment='null CA=0: release (PC if exceptions are enabled)')
-    u(SEQ='WAIT', COND='RESP_READ', ASRC='RFQ',
-      comment='the PC transfer, if asked, follows the read')
-    u(SEQ='JUMP', TGT='src_norm')
+    # Waiting for the release to be read, a save request is possible: the MPU
+    # polled null CA=1 IA=1 while the previous instruction ran, took an
+    # interrupt, and its handler saves before it has read the release.
+    # wait_first saves an idle frame with this instruction pending.
+    u(SEQ='CALL', TGT='wait_first', comment='the PC transfer, if asked, follows the read')
+    u(ASRC='RFQ', SEQ='JUMP', TGT='src_norm')
 
     # ---- the source, <ea>: FPU table 4-14, primitives table 7-5 -----------
     L('src_mem')
@@ -111,7 +114,8 @@ def emit(p):
     u(PSR='FPCR', RMR='FPCR', FPSR='CLREXC', MOP='CLRQ')
     u(RESP='WR', IMM=0x0900, ORS='PC', EXPECT='CMD', FLAG=run, comment='as register to register')
     u(RF='CROM', RFA='CMD', IMM=crom.CR_MOVECR)
-    u(SEQ='WAIT', COND='RESP_READ', ASRC='RFQ', comment='STK <= the constant\'s sticky bit')
+    u(SEQ='CALL', TGT='wait_first', comment='a save request meanwhile: as register to register')
+    u(ASRC='RFQ', comment='STK <= the constant\'s sticky bit')
     L('movecr_go')
     u(SEQ='BR', COND='A_ZERO', TGT='finish')
     u(SEQ='CALL', TGT='post')
