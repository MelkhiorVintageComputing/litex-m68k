diff --git a/libgcc/config/m68k/extended-m68k.h b/libgcc/config/m68k/extended-m68k.h
new file mode 100644
index 0000000..9dad2ab
--- /dev/null
+++ b/libgcc/config/m68k/extended-m68k.h
@@ -0,0 +1,214 @@
+/* Software floating-point emulation: the m68k extended precision format.
+   Copyright (C) 2026 Free Software Foundation, Inc.
+
+This file is part of GCC.
+
+GCC is free software; you can redistribute it and/or modify it under
+the terms of the GNU General Public License as published by the Free
+Software Foundation; either version 3, or (at your option) any later
+version.
+
+GCC is distributed in the hope that it will be useful, but WITHOUT ANY
+WARRANTY; without even the implied warranty of MERCHANTABILITY or
+FITNESS FOR A PARTICULAR PURPOSE.  See the GNU General Public License
+for more details.
+
+Under Section 7 of GPL version 3, you are granted additional
+permissions described in the GCC Runtime Library Exception, version
+3.1, as published by the Free Software Foundation.
+
+You should have received a copy of the GNU General Public License and
+a copy of the GCC Runtime Library Exception along with this program;
+see the files COPYING3 and COPYING.RUNTIME respectively.  If not, see
+<http://www.gnu.org/licenses/>.  */
+
+/* The MC68881's extended precision (XFmode, 12 bytes): a sign, a 15-bit
+   exponent biased by 16383, 16 bits of padding, and a 64-bit mantissa
+   whose integer bit is explicit.  Its value is J.F * 2**(E - 16383) for
+   every E below 32767, E = 0 included: unlike the x87 format of
+   soft-fp/extended.h, an exponent of 0 with J set is a normal number,
+   and a denormal is 0.F * 2**-16383.  That is one binade more than a
+   15-bit exponent leaves an IEEE-style format.
+
+   So the format soft-fp works in here, M, has a 16-bit exponent biased by
+   16384: M's exponent is E + 1 for a number with J set, 0 for a denormal
+   (J clear, E = 0), and 65535 for an infinity or a NaN (E = 32767).
+   Every m68k value is then exact in M, with soft-fp's own denormal rule,
+   and soft-fp rounds as it does for any format.  Packing maps back; an
+   exponent beyond m68k's range is an overflow, to infinity (these
+   routines round to nearest).  An unnormal (J clear, E nonzero) is
+   normalized on the way in, as the MC68881 does with its operands.  */
+
+#ifndef M68K_EXTENDED_M68K_H
+#define M68K_EXTENDED_M68K_H	1
+
+#if _FP_W_TYPE_SIZE != 64
+# error "extended-m68k.h expects 64-bit words (sfp-machine.h)"
+#endif
+
+#define _FP_FRACTBITS_M		(2*_FP_W_TYPE_SIZE)
+#define _FP_FRACTBITS_DW_M	(4*_FP_W_TYPE_SIZE)
+
+#define _FP_FRACBITS_M		64
+#define _FP_FRACXBITS_M		(_FP_FRACTBITS_M - _FP_FRACBITS_M)
+#define _FP_WFRACBITS_M		(_FP_WORKBITS + _FP_FRACBITS_M)
+#define _FP_WFRACXBITS_M	(_FP_FRACTBITS_M - _FP_WFRACBITS_M)
+#define _FP_EXPBITS_M		16
+#define _FP_EXPBIAS_M		16384
+#define _FP_EXPMAX_M		65535
+
+#define _FP_QNANBIT_M		\
+	((_FP_W_TYPE) 1 << (_FP_FRACBITS_M-2) % _FP_W_TYPE_SIZE)
+#define _FP_QNANBIT_SH_M		\
+	((_FP_W_TYPE) 1 << (_FP_FRACBITS_M-2+_FP_WORKBITS) % _FP_W_TYPE_SIZE)
+#define _FP_IMPLBIT_M		\
+	((_FP_W_TYPE) 1 << (_FP_FRACBITS_M-1) % _FP_W_TYPE_SIZE)
+#define _FP_IMPLBIT_SH_M		\
+	((_FP_W_TYPE) 1 << (_FP_FRACBITS_M-1+_FP_WORKBITS) % _FP_W_TYPE_SIZE)
+#define _FP_OVERFLOW_M		\
+	((_FP_W_TYPE) 1 << (_FP_WFRACBITS_M % _FP_W_TYPE_SIZE))
+
+#define _FP_WFRACBITS_DW_M	(2 * _FP_WFRACBITS_M)
+#define _FP_WFRACXBITS_DW_M	(_FP_FRACTBITS_DW_M - _FP_WFRACBITS_DW_M)
+#define _FP_HIGHBIT_DW_M	\
+  ((_FP_W_TYPE) 1 << (_FP_WFRACBITS_DW_M - 1) % _FP_W_TYPE_SIZE)
+
+#ifndef M68K_XFTYPE
+typedef float XFtype __attribute__ ((mode (XF)));
+# define M68K_XFTYPE XFtype
+#endif
+
+/* The 12 bytes as three 32-bit words: the sign and exponent in the high
+   half of the first, the mantissa in the other two.  */
+union _FP_UNION_M
+{
+  M68K_XFTYPE flt;
+  struct
+  {
+    unsigned int se;
+    unsigned int hi;
+    unsigned int lo;
+  } w;
+};
+
+#define FP_DECL_M(X)		_FP_DECL (2, X)
+
+/* To M's raw form: the mantissa in X_f0, its integer bit dropped as
+   soft-fp keeps it implicit, and the exponent as above.  */
+#define FP_UNPACK_RAW_M(X, val)						\
+  do									\
+    {									\
+      union _FP_UNION_M FP_UNPACK_RAW_M_flo;				\
+      FP_UNPACK_RAW_M_flo.flt = (val);					\
+									\
+      X##_f1 = 0;							\
+      X##_f0 = ((_FP_W_TYPE) FP_UNPACK_RAW_M_flo.w.hi << 32)		\
+	       | FP_UNPACK_RAW_M_flo.w.lo;				\
+      X##_s = FP_UNPACK_RAW_M_flo.w.se >> 31;				\
+      X##_e = (FP_UNPACK_RAW_M_flo.w.se >> 16) & 0x7fff;		\
+      if (X##_e == 0x7fff)						\
+	X##_e = _FP_EXPMAX_M;						\
+      else if (X##_f0 == 0)						\
+	X##_e = 0;							\
+      else								\
+	{								\
+	  /* An unnormal: shift up while the exponent allows.  */	\
+	  while (X##_e != 0 && !(X##_f0 & _FP_IMPLBIT_M))		\
+	    {								\
+	      X##_f0 <<= 1;						\
+	      X##_e--;							\
+	    }								\
+	  if (X##_f0 & _FP_IMPLBIT_M)					\
+	    X##_e++;							\
+	}								\
+      X##_f0 &= ~_FP_IMPLBIT_M;						\
+    }									\
+  while (0)
+
+/* From M's raw form.  An infinity has J clear, a NaN J set, as GCC's
+   constants and the MC68881 have them.  */
+#define FP_PACK_RAW_M(val, X)						\
+  do									\
+    {									\
+      union _FP_UNION_M FP_PACK_RAW_M_flo;				\
+      unsigned int FP_PACK_RAW_M_e;					\
+									\
+      if (X##_e >= 0x8000 && X##_e != _FP_EXPMAX_M)			\
+	{								\
+	  /* Beyond the largest m68k exponent: infinity.  */		\
+	  X##_e = _FP_EXPMAX_M;						\
+	  X##_f0 = 0;							\
+	}								\
+      if (X##_e == _FP_EXPMAX_M)					\
+	{								\
+	  FP_PACK_RAW_M_e = 0x7fff;					\
+	  if (X##_f0)							\
+	    X##_f0 |= _FP_IMPLBIT_M;					\
+	}								\
+      else if (X##_e == 0)						\
+	FP_PACK_RAW_M_e = 0;						\
+      else								\
+	{								\
+	  FP_PACK_RAW_M_e = X##_e - 1;					\
+	  X##_f0 |= _FP_IMPLBIT_M;					\
+	}								\
+      FP_PACK_RAW_M_flo.w.se = ((unsigned int) X##_s << 31)		\
+			       | (FP_PACK_RAW_M_e << 16);		\
+      FP_PACK_RAW_M_flo.w.hi = X##_f0 >> 32;				\
+      FP_PACK_RAW_M_flo.w.lo = X##_f0;					\
+      (val) = FP_PACK_RAW_M_flo.flt;					\
+    }									\
+  while (0)
+
+#define FP_UNPACK_M(X, val)			\
+  do						\
+    {						\
+      FP_UNPACK_RAW_M (X, (val));		\
+      _FP_UNPACK_CANONICAL (M, 2, X);		\
+    }						\
+  while (0)
+
+#define FP_UNPACK_SEMIRAW_M(X, val)		\
+  do						\
+    {						\
+      FP_UNPACK_RAW_M (X, (val));		\
+      _FP_UNPACK_SEMIRAW (M, 2, X);		\
+    }						\
+  while (0)
+
+#define FP_PACK_M(val, X)			\
+  do						\
+    {						\
+      _FP_PACK_CANONICAL (M, 2, X);		\
+      FP_PACK_RAW_M ((val), X);			\
+    }						\
+  while (0)
+
+#define FP_PACK_SEMIRAW_M(val, X)		\
+  do						\
+    {						\
+      _FP_PACK_SEMIRAW (M, 2, X);		\
+      FP_PACK_RAW_M ((val), X);			\
+    }						\
+  while (0)
+
+#define FP_ISSIGNAN_M(X)	_FP_ISSIGNAN (M, 2, X)
+#define FP_NEG_M(R, X)		_FP_NEG (M, 2, R, X)
+#define FP_ADD_M(R, X, Y)	_FP_ADD (M, 2, R, X, Y)
+#define FP_SUB_M(R, X, Y)	_FP_SUB (M, 2, R, X, Y)
