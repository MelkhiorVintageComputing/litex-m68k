+  FP_UNPACK_RAW_M (A, a);
+  FP_UNPACK_RAW_M (B, b);
+  FP_CMP_M (r, A, B, 2, 2);
+  FP_HANDLE_EXCEPTIONS;
+
+  return r;
+}
+
+strong_alias (__lexf2, __ltxf2);
+/* What fpgnulib.c provided: unordered compares above, as __lexf2.  */
+strong_alias (__lexf2, __cmpxf2);
+#endif /* !__mcoldfire__ */
