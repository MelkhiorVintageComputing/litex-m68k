diff --git a/arch/m68k/litex/config.c b/arch/m68k/litex/config.c
new file mode 100644
index 000000000..43645c2d1
--- /dev/null
+++ b/arch/m68k/litex/config.c
@@ -0,0 +1,90 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * A 68030-class CPU in a LiteX SoC (https://github.com/enjoy-digital/litex).
+ *
+ * The SoC builder places its cores; the boot loader, built against the SoC's
+ * generated headers, passes their addresses and interrupt lines as bootinfo
+ * records (asm/bootinfo-litex.h).
+ */
+
+#include <linux/kernel.h>
+#include <linux/litex.h>
+#include <linux/serial_core.h>
+
+#include <asm/bootinfo.h>
+#include <asm/bootinfo-litex.h>
+#include <asm/byteorder.h>
+#include <asm/config.h>
+#include <asm/litex.h>
+#include <asm/machdep.h>
+
+/* The SoC controller's registers. */
+#define LITEX_CTRL_RESET	0x00	/* bit 0: reset the SoC */
+
+struct litex_booter_data litex_bi_data;
+
+static void litex_get_model(char *str)
+{
+	/* str is 80 characters long */
+	sprintf(str, "LiteX SoC (%u MHz)", litex_bi_data.sys_clk / 1000000);
+}
+
+static void litex_reset(void)
+{
+	local_irq_disable();
+	if (litex_bi_data.ctrl.base)
+		litex_write32((void __iomem *)litex_bi_data.ctrl.base + LITEX_CTRL_RESET, 1);
+	for (;;)
+		;
+}
+
+static void __init litex_device(struct litex_booter_device *dev, const __be32 *data)
+{
+	dev->base = be32_to_cpu(data[0]);
+	dev->irq  = be32_to_cpu(data[1]);
+}
+
+/*
+ * Parse a LiteX-specific record in the bootinfo
+ */
+int __init litex_parse_bootinfo(const struct bi_record *record)
+{
+	const __be32 *data = (const __be32 *)record->data;
+
+	switch (be16_to_cpu(record->tag)) {
+	case BI_LITEX_SYS_CLK:
+		litex_bi_data.sys_clk = be32_to_cpu(data[0]);
+		break;
+	case BI_LITEX_IRQCTRL:
+		litex_device(&litex_bi_data.irqctrl, data);
+		break;
+	case BI_LITEX_CTRL:
+		litex_device(&litex_bi_data.ctrl, data);
+		break;
+	case BI_LITEX_UART:
+		litex_device(&litex_bi_data.uart, data);
+		break;
+	case BI_LITEX_TIMER0:
+		litex_device(&litex_bi_data.timer0, data);
+		break;
+	default:
+		return 1;
+	}
+	return 0;
+}
+
+void __init config_litex(void)
+{
+	char earlycon[24];
+
+	if (litex_bi_data.uart.base) {
+		snprintf(earlycon, sizeof(earlycon), "liteuart,0x%08x",
+			 litex_bi_data.uart.base);
+		setup_earlycon(earlycon);
+	}
+
+	mach_init_IRQ = litex_init_IRQ;
+	mach_sched_init = litex_sched_init;
+	mach_get_model = litex_get_model;
+	mach_reset = litex_reset;
+}
