diff --git a/arch/m68k/include/asm/litex.h b/arch/m68k/include/asm/litex.h
new file mode 100644
index 000000000..586d7fa85
--- /dev/null
+++ b/arch/m68k/include/asm/litex.h
@@ -0,0 +1,42 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef __ASM_M68K_LITEX_H
+#define __ASM_M68K_LITEX_H
+
+/*
+ * The SoC's CSRs are mapped transparently (TT1, head.S), uncached, from
+ * LITEX_TT_BASE to the end of the address space, above the kernel's KMAP
+ * window (KMAP_END, 0xf0000000 on 030/040): ioremap() of an address there
+ * returns it unchanged. The boot loader's addresses for the cores must be
+ * there.
+ */
+#define LITEX_TT_BASE	0xf0000000
+#define LITEX_TT_SIZE	0x10000000
+
+#ifndef __ASSEMBLER__
+
+#include <asm/irq.h>
+
+/* The SoC's interrupt lines, bit n of the CPU's pending/mask CSRs. */
+#define LITEX_IRQ_BASE		IRQ_USER
+#define LITEX_NR_IRQS		32
+
+struct litex_booter_device {
+	u32 base;
+	u32 irq;	/* a line, or the IPL for the interrupt controller */
+};
+
+struct litex_booter_data {
+	u32 sys_clk;
+	struct litex_booter_device irqctrl;
+	struct litex_booter_device ctrl;
+	struct litex_booter_device uart;
+	struct litex_booter_device timer0;
+};
+
+extern struct litex_booter_data litex_bi_data;
+
+extern void __init litex_init_IRQ(void);
+extern void __init litex_sched_init(void);
+
+#endif /* !__ASSEMBLER__ */
+#endif /* __ASM_M68K_LITEX_H */
