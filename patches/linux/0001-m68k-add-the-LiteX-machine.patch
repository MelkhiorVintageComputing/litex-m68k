diff --git a/arch/m68k/include/uapi/asm/bootinfo-litex.h b/arch/m68k/include/uapi/asm/bootinfo-litex.h
new file mode 100644
index 000000000..d065b16f2
--- /dev/null
+++ b/arch/m68k/include/uapi/asm/bootinfo-litex.h
@@ -0,0 +1,24 @@
+/* SPDX-License-Identifier: GPL-2.0 WITH Linux-syscall-note */
+/*
+ * asm/bootinfo-litex.h -- LiteX SoC specific boot information definitions
+ *
+ * A LiteX SoC's cores sit where the SoC builder put them: the boot loader,
+ * built against the SoC's generated headers, says where. Records with a
+ * "line" give the core's interrupt line, its bit in the CPU's interrupt
+ * controller.
+ */
+
+#ifndef _UAPI_ASM_M68K_BOOTINFO_LITEX_H
+#define _UAPI_ASM_M68K_BOOTINFO_LITEX_H
+
+#define BI_LITEX_SYS_CLK	0x8000	/* __be32 sys clock, Hz */
+#define BI_LITEX_IRQCTRL	0x8001	/* __be32 base, __be32 IPL: the CPU's
+					   pending (+0) and mask (+4) CSRs,
+					   every line on one autovectored
+					   level */
+#define BI_LITEX_CTRL		0x8002	/* __be32 base, 0: the SoC controller */
+#define BI_LITEX_UART		0x8003	/* __be32 base, __be32 line: LiteUART */
+#define BI_LITEX_TIMER0		0x8004	/* __be32 base, __be32 line: Timer, with
+					   its uptime counter */
+
+#endif /* _UAPI_ASM_M68K_BOOTINFO_LITEX_H */
