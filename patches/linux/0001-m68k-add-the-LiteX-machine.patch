@@ -0,0 +1,84 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * The CPU's interrupt controller in a LiteX SoC: every interrupt line of the
+ * SoC on one autovectored level (BI_LITEX_IRQCTRL's IPL), and two CSRs, the
+ * lines as they are (pending) and the lines allowed to interrupt (mask).
+ * Line n is Linux interrupt LITEX_IRQ_BASE + n. The lines are levels: a core
+ * keeps its line up until its driver acknowledges it.
+ */
+
+#include <linux/interrupt.h>
+#include <linux/irq.h>
+#include <linux/kernel.h>
+#include <linux/litex.h>
+#include <linux/spinlock.h>
+
+#include <asm/irq.h>
+#include <asm/litex.h>
+
+#define LITEX_IRQ_PENDING	0x00
+#define LITEX_IRQ_MASK		0x04
+
+static void __iomem *litex_irq_base;
+static u32 litex_irq_mask;
+static DEFINE_RAW_SPINLOCK(litex_irq_lock);
+
+static void litex_irq_update(u32 set, u32 clear)
+{
+	unsigned long flags;
+
+	raw_spin_lock_irqsave(&litex_irq_lock, flags);
+	litex_irq_mask = (litex_irq_mask | set) & ~clear;
+	litex_write32(litex_irq_base + LITEX_IRQ_MASK, litex_irq_mask);
+	raw_spin_unlock_irqrestore(&litex_irq_lock, flags);
+}
+
+static void litex_irq_enable(struct irq_data *data)
+{
+	litex_irq_update(BIT(data->irq - LITEX_IRQ_BASE), 0);
+}
+
+static void litex_irq_disable(struct irq_data *data)
+{
+	litex_irq_update(0, BIT(data->irq - LITEX_IRQ_BASE));
+}
+
+static unsigned int litex_irq_startup(struct irq_data *data)
+{
+	litex_irq_enable(data);
+	return 0;
+}
+
+static struct irq_chip litex_irq_chip = {
+	.name		= "litex",
+	.irq_enable	= litex_irq_enable,
+	.irq_disable	= litex_irq_disable,
+	.irq_startup	= litex_irq_startup,
+	.irq_shutdown	= litex_irq_disable,
+};
+
+static void litex_irq_demux(struct irq_desc *desc)
+{
+	u32 pending = litex_read32(litex_irq_base + LITEX_IRQ_PENDING) &
+		      litex_irq_mask;
+
+	while (pending) {
+		unsigned int line = __ffs(pending);
+
+		generic_handle_irq(LITEX_IRQ_BASE + line);
+		pending &= pending - 1;
+	}
+}
+
+void __init litex_init_IRQ(void)
+{
+	litex_irq_base = (void __iomem *)litex_bi_data.irqctrl.base;
+	litex_irq_mask = 0;
+	litex_write32(litex_irq_base + LITEX_IRQ_MASK, 0);
+
+	m68k_setup_irq_controller(&litex_irq_chip, handle_simple_irq,
+				  LITEX_IRQ_BASE, LITEX_NR_IRQS);
+
+	/* IRQ_AUTO_n is n: the autovectored level of the controller. */
+	irq_set_chained_handler(litex_bi_data.irqctrl.irq, litex_irq_demux);
+}
diff --git a/arch/m68k/litex/platform.c b/arch/m68k/litex/platform.c
new file mode 100644
index 000000000..506b46c0f
--- /dev/null
+++ b/arch/m68k/litex/platform.c
@@ -0,0 +1,32 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * The LiteX cores Linux has a driver for, as platform devices: LiteUART.
+ */
+
+#include <linux/init.h>
+#include <linux/ioport.h>
+#include <linux/platform_device.h>
+
+#include <asm/litex.h>
+#include <asm/setup.h>
+
+#define LITEX_UART_SIZE	0x20
+
+static int __init litex_platform_init(void)
+{
+	struct resource res[2];
+	struct platform_device *pdev;
+
+	if (!MACH_IS_LITEX || !litex_bi_data.uart.base)
+		return -ENODEV;
+
+	res[0] = (struct resource)DEFINE_RES_MEM(litex_bi_data.uart.base,
+						  LITEX_UART_SIZE);
+	res[1] = (struct resource)DEFINE_RES_IRQ(LITEX_IRQ_BASE +
+						  litex_bi_data.uart.irq);
+	pdev = platform_device_register_simple("liteuart", PLATFORM_DEVID_NONE,
+					       res, ARRAY_SIZE(res));
+	return PTR_ERR_OR_ZERO(pdev);
+}
+
+device_initcall(litex_platform_init);
diff --git a/arch/m68k/litex/timer.c b/arch/m68k/litex/timer.c
new file mode 100644
index 000000000..783dc974a
--- /dev/null
+++ b/arch/m68k/litex/timer.c
@@ -0,0 +1,112 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * LiteX's Timer core as the clock event device, and its uptime counter (a
+ * 64-bit count of sys clock cycles, the SoC's --timer-uptime) as the clock
+ * source.
+ *
+ * The Timer counts down from `load` once enabled, and at 0 takes `reload`
+ * (0: it stays at 0); its "zero" event is the edge into 0. One-shot: load =
+ * delta, reload = 0. Periodic: load = reload = period - 1.
+ */
+
+#include <linux/clockchips.h>
+#include <linux/clocksource.h>
+#include <linux/interrupt.h>
+#include <linux/kernel.h>
+#include <linux/litex.h>
+
+#include <asm/litex.h>
+
+#define TIMER_LOAD		0x00
+#define TIMER_RELOAD		0x04
+#define TIMER_EN		0x08
+#define TIMER_EV_PENDING	0x18
+#define TIMER_EV_ENABLE		0x1c
+#define TIMER_UPTIME_LATCH	0x20
+#define TIMER_UPTIME_CYCLES	0x24	/* 64 bits: two CSRs, high first */
+
+static void __iomem *timer_base;
+
+static void litex_timer_start(u32 load, u32 reload)
+{
+	litex_write32(timer_base + TIMER_EN, 0);
+	litex_write32(timer_base + TIMER_LOAD, load);
+	litex_write32(timer_base + TIMER_RELOAD, reload);
+	litex_write32(timer_base + TIMER_EV_PENDING, 1);
+	litex_write32(timer_base + TIMER_EN, 1);
+}
+
+static int litex_timer_next_event(unsigned long delta,
+				  struct clock_event_device *evt)
+{
+	litex_timer_start(delta, 0);
+	return 0;
+}
+
+static int litex_timer_periodic(struct clock_event_device *evt)
+{
+	u32 period = DIV_ROUND_CLOSEST(litex_bi_data.sys_clk, HZ) - 1;
+
+	litex_timer_start(period, period);
+	return 0;
+}
+
+static int litex_timer_shutdown(struct clock_event_device *evt)
+{
+	litex_write32(timer_base + TIMER_EN, 0);
+	return 0;
+}
+
+static struct clock_event_device litex_clockevent = {
+	.name			= "litex_timer0",
+	.features		= CLOCK_EVT_FEAT_PERIODIC | CLOCK_EVT_FEAT_ONESHOT,
+	.rating			= 300,
+	.set_next_event		= litex_timer_next_event,
+	.set_state_periodic	= litex_timer_periodic,
+	.set_state_oneshot	= litex_timer_shutdown,
+	.set_state_shutdown	= litex_timer_shutdown,
+	.tick_resume		= litex_timer_shutdown,
+};
+
+static irqreturn_t litex_timer_interrupt(int irq, void *dev_id)
+{
+	struct clock_event_device *evt = dev_id;
+
+	litex_write32(timer_base + TIMER_EV_PENDING, 1);
+	evt->event_handler(evt);
+	return IRQ_HANDLED;
+}
+
+static u64 litex_uptime_read(struct clocksource *cs)
+{
+	litex_write32(timer_base + TIMER_UPTIME_LATCH, 1);
+	return litex_read64(timer_base + TIMER_UPTIME_CYCLES);
+}
+
+static struct clocksource litex_clocksource = {
+	.name	= "litex_uptime",
+	.rating	= 300,
+	.read	= litex_uptime_read,
+	.mask	= CLOCKSOURCE_MASK(64),
+	.flags	= CLOCK_SOURCE_IS_CONTINUOUS,
+};
+
+void __init litex_sched_init(void)
+{
+	unsigned int irq = LITEX_IRQ_BASE + litex_bi_data.timer0.irq;
+
+	timer_base = (void __iomem *)litex_bi_data.timer0.base;
+	litex_write32(timer_base + TIMER_EN, 0);
+	litex_write32(timer_base + TIMER_EV_PENDING, 1);
+	litex_write32(timer_base + TIMER_EV_ENABLE, 1);
+
+	clocksource_register_hz(&litex_clocksource, litex_bi_data.sys_clk);
+
+	if (request_irq(irq, litex_timer_interrupt, IRQF_TIMER, "timer0",
+			&litex_clockevent))
+		pr_err("litex: cannot register the timer interrupt %u\n", irq);
+	litex_clockevent.cpumask = cpu_possible_mask;
+	litex_clockevent.irq = irq;
+	clockevents_config_and_register(&litex_clockevent,
+					litex_bi_data.sys_clk, 16, 0xffffffff);
+}
