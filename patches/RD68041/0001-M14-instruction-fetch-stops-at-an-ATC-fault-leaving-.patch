+## Found by litex-68k: Linux in a LiteX SoC
+
+1. **An instruction fetch went on past an ATC fault, and left an entry not
+   resident for the next page.** The fetch unit queued a faulted fetch's words
+   marked (`q_atc`) and then fetched on, so a fault near the end of a page went
+   on to the next page and searched the tables for it; that page invalid too, its
+   ATC entry was made not resident (UM 3.2.2.3). Linux's handler for the first
+   fault maps the faulting page and, by fault-around, the next ones, and flushes
+   the ATC entry of the faulting page only (a PTEST in `access_error040`): the
+   fetch after its RTE hit the stale entry for the next page and faulted again,
+   and Linux, whose PTEST now found that page resident, took the fault as a
+   protection violation and killed the process. With glibc's busybox as init the
+   first call of `fopen64`, at the end of a page, ran into the next one with a
+   `MOVE.L 12(SP),-(SP)` across the two: init died of SIGSEGV and the kernel
+   panicked. The fetch unit now stops after an ATC fault until the next redirect
+   (`xstop` in `rd68041_ifu`): the words after the fault can only be wanted after
+   the faulted ones, whose fault comes first. Nothing here reached it: no bench or
+   program made a page resident behind a fault on the page before it, and rd-virt
+   and rd-qvirt's Linux never happened to. `core_fetchnext_tb`
+   (`sim/programs/m15_fetch_next.S`) does: two faults without the fix, one with it.
+
+---
+
 ## M14: found by MAME's Quadra
 
 1. **A serialised page's read could be made twice.** The core makes an instruction's
diff --git a/rtl/rd68041_ifu.sv b/rtl/rd68041_ifu.sv
index ef0d780..2d16d2a 100644
--- a/rtl/rd68041_ifu.sv
+++ b/rtl/rd68041_ifu.sv
@@ -45,8 +45,17 @@
 // in the ATC asks the data memory unit for a table search (iw_req), which
 // hands back the entry (iw_fill); then the lookup is done again. An entry not
 // resident, or a user fetch from a supervisor page, puts the words marked in
-// the queue (q_err and q_atc), as a bus error does. PFLUSH and PTEST of a
-// program space flush the ATC from the data memory unit (if_flush).
+// the queue (q_err and q_atc), as a bus error does, and fetching stops there
+// until the next redirect (xstop): the words after the fault can only be
+// wanted after those, whose fault comes first, and fetching on would search
+// the tables for the next page, leaving in the ATC an entry not resident for
+// a page the handler of this fault may well make resident (Linux's fault-
+// around does), which the fetch after its RTE would then fault on again --
+// and Linux, finding that page resident by PTEST, takes that second fault as
+// a protection violation (doc/bugs-found.md).
+//
+// PFLUSH and PTEST of a program space flush the ATC from the data memory unit
+// (if_flush).
 
 module rd68041_ifu (
     input  logic          clk,
@@ -124,6 +133,7 @@ module rd68041_ifu (
   logic [31:0] fa;              // the next word to fetch
   logic        on;              // fetching
   logic        aerr;            // redirected to an odd address: nothing to fetch
+  logic        xstop;           // a fetch faulted in the ATC: nothing more until a redirect
 
   // The window.
   always_comb begin
@@ -321,7 +331,7 @@ module rd68041_ifu (
   wire [1:0] pick = victim(p0_valid, rnd);
 
   // --- the bus ---------------------------------------------------------------------
-  assign want_lk = on && !stop && !aerr && !go && (fs == F_IDLE) && (room >= 4'd4);
+  assign want_lk = on && !stop && !aerr && !xstop && !go && (fs == F_IDLE) && (room >= 4'd4);
   assign f_valid = ((fs == F_FILL) || (fs == F_LONG)) && !busy;
   assign f_addr  = (fs == F_FILL) ? {lp, la[11:2], 2'b00} : {lp, fa[11:2], 2'b00};
   assign f_siz   = (fs == F_FILL) ? rd68041_pkg::SIZ_LINE : rd68041_pkg::SIZ_LONG;
@@ -335,6 +345,7 @@ module rd68041_ifu (
       lcm   <= '0;
       lupa  <= '0;
       aerr  <= 1'b0;
+      xstop <= 1'b0;
       head  <= '0;
       cnt   <= '0;
       hpc   <= '0;
@@ -360,6 +371,7 @@ module rd68041_ifu (
       cnt   <= '0;
       on    <= 1'b0;
       aerr  <= 1'b0;
+      xstop <= 1'b0;
       fs    <= F_IDLE;
       busy  <= 1'b0;
       drop  <= 1'b0;
@@ -378,6 +390,7 @@ module rd68041_ifu (
       if (in_n > 3'd3) begin q[wi[3]] <= in_w[3]; qe[wi[3]] <= in_e; qt[wi[3]] <= in_t; end
       cnt <= cnt_nxt;
       if (in_n != 3'd0) fa <= fa_nxt;
+      if (atc_in) xstop <= 1'b1;
 
       // --- the fetch -----------------------------------------------------------
       case (fs)
@@ -452,6 +465,7 @@ module rd68041_ifu (
         fa   <= go_pc;
         on   <= 1'b1;
         aerr <= go_pc[0];
+        xstop <= 1'b0;
         if (fs == F_LOOK) drop <= 1'b1;
         if (busy && !f_done) drop <= 1'b1;
         if (f_valid && f_ready) drop <= 1'b1;
diff --git a/sim/programs/m15_fetch_next.S b/sim/programs/m15_fetch_next.S
new file mode 100644
index 0000000..135029b
--- /dev/null
+++ b/sim/programs/m15_fetch_next.S
@@ -0,0 +1,107 @@
+| SPDX-License-Identifier: CERN-OHL-S-2.0
+| Copyright 2026 Romain Dolbeau
+| Source location: https://github.com/MelkhiorVintageComputing/RD68041
+
+| RD68041 -- an instruction fetch's ATC fault, and the page after it, for
+| sim/tb/core_fetchnext_tb.sv. Found running Linux (litex-68k): busybox's
+| first call of fopen64 in glibc, whose code ran from the end of one page not
+| yet resident into the next one, not resident either.
+|
+| Pages $16 and $17 are invalid. A JSR to $16FF8 faults (UM 8.4.6: ATC, the
+| program space, FA $16FF8). The handler makes both pages resident, mapped to
+| two consecutive pages of this program, as Linux's handler does when it maps
+| the faulting page and, by fault-around, its neighbours; and, as Linux's
+| does, it flushes the ATC entry of the faulting page only (PFLUSH, UM 3.7.2;
+| Linux by PTEST), then returns. The code from $16FF8 runs into page $17 with
+| an instruction across the two (a MOVE.L #imm at $16FFE): page $17 was never
+| fetched before the handler made it resident, so its first fetch searches
+| the tables and finds it so -- one fault, not two. Every fault's FA goes to
+| OUT + $20 on, their count to OUT; the code's result (D5) to OUT + 4.
+
+        .equ    ISP_TOP, 0x0000F000
+        .equ    OUT,     0x0000FD00
+        .equ    DONE,    0x0000FDFC
+        .equ    ROOT,    0x0000A000
+        .equ    PTR,     0x0000A200
+        .equ    PT,      0x0000A400
+
+        .section .vectors, "a"
+        .long   ISP_TOP                          | 0
+        .long   _start                           | 1
+        .long   h_fault                          | 2  access fault
+        .long   h_bad                            | 3
+        .long   h_end                            | 4  ILLEGAL: the end
+        .rept   251                              | 5-255
+        .long   h_bad
+        .endr
+
+        .text
+        .globl  _start
+_start:
+        | The tables, as m10_mmu.S's: pages 0-15 identity; $16 and $17
+        | invalid, and what the handler will make them.
+        move.l  #PTR + 2, ROOT
+        move.l  #PT + 2, PTR
+        lea     PT, %a0
+        moveq   #0, %d0
+1:      move.l  %d0, %d1
+        ori.l   #1, %d1
+        move.l  %d1, (%a0)+
+        addi.l  #0x1000, %d0
+        cmpi.l  #0x10000, %d0
+        bne.s   1b
+        clr.l   PT + 4*0x16
+        clr.l   PT + 4*0x17
+        lea     pg1, %a0
+        move.l  %a0, %d0
+        ori.l   #1, %d0
+        move.l  %d0, OUT + 0x10                  | page $16's descriptor to be
+        addi.l  #0x1000, %d0
+        move.l  %d0, OUT + 0x14                  | page $17's
+        clr.l   OUT                              | the faults
+        moveq   #0, %d5
+
+        move.l  #ROOT, %d0
+        movec   %d0, %urp
+        movec   %d0, %srp
+        pflusha
+        move.l  #0x8000, %d0                     | E, 4 KB pages
+        movec   %d0, %tc
+
+        jsr     0x16FF8
+        move.l  %d5, OUT + 4
+        move.l  #0xC0DE0000, DONE
+        illegal
+
+| An access fault: count it, keep its FA, make pages $16 and $17 resident,
+| flush the ATC entry of the faulting page (the supervisor program space:
+| DFC 6), and return. A third is the end.
+h_fault:
+        addq.l  #1, OUT
+        move.l  OUT, %d0
+        lsl.l   #2, %d0
+        lea     OUT + 0x1C, %a0
+        move.l  20(%sp), (%a0, %d0.l)
+        cmpi.l  #3, OUT
+        bge.s   h_end
+        move.l  OUT + 0x10, PT + 4*0x16
+        move.l  OUT + 0x14, PT + 4*0x17
+        moveq   #6, %d0
+        movec   %d0, %dfc
+        movea.l 20(%sp), %a0
+        pflush  (%a0)
+        rte
+h_bad:
+        move.l  #0x0bad, OUT + 8
+h_end:  bra.s   h_end
+
+| Two pages: page $16 is mapped to pg1, page $17 to the one after it.
+        .balign 4096
+pg1:
+        .fill   0xFF8, 1, 0
+        moveq   #1, %d5                          | $16FF8
+        addq.l  #1, %d5                          | $16FFA
+        nop                                      | $16FFC
+        move.l  #0x2A2A2A2A, %d5                 | $16FFE: across into page $17
+        addq.l  #1, %d5                          | $17004
+        rts
diff --git a/sim/tb/core_fetchnext_tb.sv b/sim/tb/core_fetchnext_tb.sv
new file mode 100644
index 0000000..175479a
--- /dev/null
+++ b/sim/tb/core_fetchnext_tb.sv
@@ -0,0 +1,68 @@
+// SPDX-License-Identifier: CERN-OHL-S-2.0
+// Copyright 2026 Romain Dolbeau
+// Source location: https://github.com/MelkhiorVintageComputing/RD68041
+
+// RD68041 -- sim/programs/m15_fetch_next.S on the core: an instruction fetch's
+// ATC fault on a page, then code that runs into the next page, which the
+// fault's handler made resident too. One fault, on the first page (UM 8.4.6,
+// FA $16FF8), not a second on the next: the fetch must not have searched the
+// tables for the next page, and left an entry not resident for it in the
+// ATC, before the handler made it resident.
+
+`timescale 1ns / 1ps
+
+module core_fetchnext_tb;
+
+`include "rd68041_core_harness.svh"
+
+  localparam logic [31:0] OUT  = 32'h0000_FD00;
+  localparam logic [31:0] DONE = 32'h0000_FDFC;
+
+  string       image;
+  int unsigned nfail;
+  bit          done;
+
+  task automatic check(input string what, input logic [31:0] got, input logic [31:0] exp);
+    if (got !== exp) begin
+      $display("  FAIL: %s is %h, expected %h", what, got, exp);
+      nfail++;
+    end
+  endtask
+
+  task automatic finish_up();
+    check("the access faults taken", u_mem.peek_long(OUT), 32'd1);
+    check("the first fault's FA", u_mem.peek_long(OUT + 32'h20), 32'h0001_6FF8);
+    if (u_mem.peek_long(OUT) > 1)
+      $display("  (the second fault's FA: %h)", u_mem.peek_long(OUT + 32'h24));
+    check("the code's result (D5)", u_mem.peek_long(OUT + 32'h04), 32'h2A2A_2A2B);
+    check("no stray exception", u_mem.peek_long(OUT + 32'h08), 32'h0);
+    if (nfail == 0) $display("PASS: core_fetchnext_tb: one ATC fault, none on the next page");
+    else            $display("FAIL: core_fetchnext_tb: %0d checks failed", nfail);
+    $finish;
+  endtask
+
+  always @(posedge clk) begin
+    if (!done && rst_n && (u_mem.peek_long(DONE) == 32'hC0DE_0000 || dut.u_core.halted ||
+                           u_mem.peek_long(OUT) >= 3)) begin
+      done = 1;
+      repeat (8) @(posedge clk);
+      finish_up();
+    end
+  end
+
+  initial begin
+    if (!$value$plusargs("image=%s", image)) image = "build/programs/m15_fetch_next.hex";
+    nfail = 0; done = 0;
+    boot(image);
+  end
+
+  initial begin
+    #5000000;
+    if (!done) begin
+      $display("  FAIL: timed out at PC %h", dut.u_core.w_u.pc);
+      $display("FAIL: core_fetchnext_tb");
+      $finish;
+    end
+  end
+
+endmodule
