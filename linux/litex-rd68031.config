# SPDX-License-Identifier: CERN-OHL-S-2.0
# Copyright 2026 Romain Dolbeau
# Adapted from RD68031's sim/virt/linux/rd-virt.config
# (https://github.com/MelkhiorVintageComputing/RD68031): the m68k LiteX machine
# (patches/linux) instead of virt, an MC68030 with an MC68881 (RD68031+fpu),
# LiteUART for the console. Applied over allnoconfig (linux/build.sh).
CONFIG_LOCALVERSION="-litex"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_DEFAULT_HOSTNAME="litex68k"
CONFIG_SYSVIPC=y
CONFIG_PRINTK=y
CONFIG_BUG=y
CONFIG_MULTIUSER=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SHMEM=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_INITRAMFS_SOURCE=""
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y
# CPU / machine: an MC68030 and its MC68881, or an MC68040 (RD68041, L15: one
# kernel for both; M68040 brings the M68040FPSP for the instructions the 040
# leaves to software), no FPU emulation
CONFIG_MMU=y
CONFIG_M68KCLASSIC=y
CONFIG_M68030=y
# CONFIG_M68020 is not set
CONFIG_M68040=y
# CONFIG_M68060 is not set
# CONFIG_M68KFPU_EMU is not set
CONFIG_M68K_LITEX=y
# CONFIG_VIRT is not set
# CONFIG_AMIGA is not set
# CONFIG_ATARI is not set
# CONFIG_MAC is not set
# CONFIG_APOLLO is not set
# CONFIG_VME is not set
# CONFIG_HP300 is not set
# CONFIG_Q40 is not set
# CONFIG_SUN3X is not set
CONFIG_PROC_HARDWARE=y
# devices
CONFIG_BLOCK=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TTY=y
CONFIG_SERIAL_LITEUART=y
CONFIG_SERIAL_LITEUART_CONSOLE=y
# filesystems
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_EXT2_FS=y
# no networking yet
# CONFIG_NET is not set
# CONFIG_MODULES is not set
CONFIG_PRINTK_TIME=y
