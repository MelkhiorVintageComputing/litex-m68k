# SPDX-License-Identifier: BSD-2-Clause
# Over buildroot's BusyBox configuration: awk's math functions (sin, atan2,
# sqrt, ...) through libm, which l7_test.py's command set uses.
CONFIG_FEATURE_AWK_LIBM=y
# L10 (doc/l10-devicetree.md): a filesystem on the SD card, and nc for raw
# transfers over Ethernet.
CONFIG_MKFS_EXT2=y
CONFIG_MKFS_VFAT=y
CONFIG_NC=y
CONFIG_NC_SERVER=y
