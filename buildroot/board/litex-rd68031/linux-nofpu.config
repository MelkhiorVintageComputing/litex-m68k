# SPDX-License-Identifier: BSD-2-Clause
# The FPU-less kernel (RD68031 without RD68884): over linux.defconfig's
# configuration, the FPU emulator. Without it the kernel saves the FPU at
# every task switch (FSAVE, a line-F trap with no FPU) and panics at boot,
# "no FPU"; with it, both are skipped when the bootinfo says FPU none. The
# userspace is soft-float, so the emulator itself does not run.
CONFIG_M68KFPU_EMU=y
