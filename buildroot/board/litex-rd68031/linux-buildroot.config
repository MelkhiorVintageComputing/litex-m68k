# SPDX-License-Identifier: BSD-2-Clause
# What buildroot's userspace needs over L7's kernel (linux/litex-rd68031.config):
# UNIX sockets for syslogd, ptys for the devpts line of its fstab.
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_UNIX98_PTYS=y
# L10 (doc/l10-devicetree.md): the devices of the boot loader's device tree.
# Ethernet, LiteEth, with IPv4 and packet sockets (udhcpc).
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_NET_VENDOR_LITEX=y
CONFIG_LITEX_LITEETH=y
# The SD card, LiteSDCard, with its card's filesystems.
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_LITEX=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
